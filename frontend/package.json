{
    "name": "frontend",
    "type": "module",
    "private": true,
    "engines": {
        "node": "24.x"
    },
    "scripts": {
        "build": "nuxt build",
        "dev": "nuxt dev",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "typecheck": "nuxt typecheck",
        "test": "vitest run"
    },
    "lint-staged": {
        "*.{vue,ts,js,mjs,cjs}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,yml,yaml,css}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@mfp-design-system/all": "^5.0.0",
        "@mfp-design-system/tokens": "^0.9.0",
        "@nuxt/scripts": "1.3.12",
        "@nuxtjs/supabase": "^2.0.9",
        "@nuxtjs/turnstile": "1.1.3",
        "@vite-pwa/nuxt": "^1.1.1",
        "nostics": "^1.3.0",
        "nuxt": "^4.4.8",
        "vue": "^3.5.39",
        "vue-router": "^5.1.0"
    },
    "devDependencies": {
        "@nuxt/eslint": "^1.16.0",
        "@types/node": "^24.19.2",
        "eslint": "^10.7.0",
        "prettier": "^3.9.5",
        "typescript": "6.0.3",
        "vitest": "5.0.3",
        "vue-tsc": "^3.3.13"
    }
}
