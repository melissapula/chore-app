# Copy to .env and fill in. NEVER commit .env.
# Uses the shared Frula (fsbo-platform) Supabase project; app data lives in the
# `chore` schema.

# Frula Supabase project settings → API
SUPABASE_URL=https://your-frula-project-ref.supabase.co
SUPABASE_KEY=your-anon-key

# NestJS API base URL
API_BASE=http://localhost:3000

# Cloudflare Turnstile site key for the sign-in CAPTCHA widget on /login.
# REQUIRED when SUPABASE_URL is the live project: CAPTCHA is enforced there, so
# without it there's no widget, no token, and every login fails. Copy it from
# Vercel or Cloudflare → Turnstile; `localhost` must be in the widget's
# hostnames. Leave blank only against the local stack (`npx supabase@2 start`),
# where captcha is off. The matching secret lives in the Supabase dashboard
# (Attack Protection), not here.
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
